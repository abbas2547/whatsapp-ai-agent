# =========================================================
# WhatsApp AI Agent SaaS — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file that contains real keys.
# Never expose these to the browser — do NOT prefix with
# NEXT_PUBLIC_. Anything secret must only be read server-side.
# =========================================================

# -------------------------------
# Application
# -------------------------------
# Local dev value shown. In PRODUCTION this must be your public domain
# (https://yourdomain.com) — Auth.js builds every login/callback URL from
# NEXTAUTH_URL when it is set, so leaving it as localhost breaks Google login
# on your live site (users bounce to localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------
# Database (Prisma / Supabase Postgres)
# -------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# -------------------------------
# Redis — native redis:// OR Upstash REST (auto-detected)
# -------------------------------
# Native Redis Cloud / Redis.io / self-hosted:
# REDIS_URL=redis://default:PASSWORD@HOST:PORT
# TLS variant: rediss://default:PASSWORD@HOST:PORT
# Upstash REST variant:
# REDIS_URL=https://HOST.upstash.io
# REDIS_TOKEN=...
REDIS_URL=redis://default:PASSWORD@HOST:PORT
REDIS_TOKEN=
# Legacy alias for Upstash REST token:
REDIS_API_KEY=

# -------------------------------
# Meta / Facebook (OAuth + Graph API)
# -------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# -------------------------------
# WhatsApp Cloud API
# -------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -------------------------------
# Google OAuth (Login + Google Calendar/Gmail integration)
# -------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------
# AI — OpenRouter (primary) + Gemini (legacy fallback)
# -------------------------------
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Optional: pick the primary chat model (default: openai/gpt-4o-mini — best
# speed/cost/tool-calling balance for WhatsApp agents).
# OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: comma-separated fallbacks used when the primary 429s/503s.
# OPENROUTER_FALLBACKS=google/gemini-flash-1.5,anthropic/claude-3.5-haiku,meta-llama/llama-3.1-70b-instruct
# Optional: embeddings model for knowledge search (default: openai/text-embedding-3-small).
# OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
# Optional: override gateway + attribution headers.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_NAME=eluue ai agent
# OPENROUTER_SITE_URL=https://yourdomain.com
# Optional: force provider — openrouter | gemini (default: auto).
# AI_PROVIDER=openrouter
# Legacy Gemini (only used when OPENROUTER_API_KEY is missing):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# -------------------------------
# Supabase (storage / auth utilities)
# -------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# -------------------------------
# Cloudinary (media / asset storage)
# -------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------
# Payments (Cashfree)
# -------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production — controls API base URL, checkout SDK mode and stored env
CASHFREE_ENVIRONMENT=sandbox
# Optional: PG API version header (defaults to 2023-08-01)
CASHFREE_API_VERSION=
# Optional: separate webhook signing secret (defaults to CASHFREE_SECRET_KEY)
CASHFREE_WEBHOOK_SECRET=

# -------------------------------
# NextAuth
# -------------------------------
NEXTAUTH_SECRET=
# Local dev value shown. In PRODUCTION set this to your public domain
# (https://yourdomain.com) or REMOVE it and rely on auto-detected host.
# A localhost value here forces ALL auth URLs (including the Google OAuth
# callback) to localhost:3000 on your live site.
NEXTAUTH_URL=http://localhost:3000
