# =========================================================
# WhatsApp AI Agent SaaS — Environment Variables
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` or any file that contains real keys.
# Never expose these to the browser — do NOT prefix with
# NEXT_PUBLIC_. Anything secret must only be read server-side.
# =========================================================

# -------------------------------
# Application
# -------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -------------------------------
# Database (Prisma / Supabase Postgres)
# -------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# -------------------------------
# Redis (Upstash REST)
# -------------------------------
REDIS_URL=https://USER:PASSWORD@HOST.upstash.io
REDIS_API_KEY=

# -------------------------------
# Meta / Facebook (OAuth + Graph API)
# -------------------------------
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_VERIFY_TOKEN=

# -------------------------------
# WhatsApp Cloud API
# -------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# -------------------------------
# Google OAuth (Login + Google Calendar/Gmail integration)
# -------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------------------------------
# AI — Gemini
# -------------------------------
GEMINI_API_KEY=

# -------------------------------
# Supabase (storage / auth utilities)
# -------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# -------------------------------
# Cloudinary (media / asset storage)
# -------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -------------------------------
# Payments (Cashfree)
# -------------------------------
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENVIRONMENT=

# -------------------------------
# NextAuth
# -------------------------------
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
